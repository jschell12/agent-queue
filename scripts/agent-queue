    project = args.project
    item_id = int(args.id)

    def do_hold():
        items = load_queue(project)
        item = find_item(items, item_id)
        if not item:
            print(json.dumps({"error": "not_found"}), file=sys.stderr)
            sys.exit(1)
        item["status"] = "held"
        item["updated_at"] = now_iso()
        save_queue(project, items)
        return item

    item = with_lock(project, do_hold)
    print(json.dumps(item))


def cmd_unhold(args):
    project = args.project
    item_id = int(args.id)

    def do_unhold():
        items = load_queue(project)
        item = find_item(items, item_id)
        if not item:
            print(json.dumps({"error": "not_found"}), file=sys.stderr)
            sys.exit(1)
        item["status"] = "pending"
        item["updated_at"] = now_iso()
        save_queue(project, items)
        return item

    item = with_lock(project, do_unhold)
    print(json.dumps(item))


def cmd_reorder(args):
    project = args.project
    item_id = int(args.id)

    def do_reorder():
        items = load_queue(project)
        item = find_item(items, item_id)
        if not item:
            print(json.dumps({"error": "not_found"}), file=sys.stderr)
            sys.exit(1)
        items.remove(item)
        if args.before:
            target = find_item(items, int(args.before))
            if target:
                idx = items.index(target)
                items.insert(idx, item)
            else:
                items.append(item)
        elif args.after:
            target = find_item(items, int(args.after))
            if target:
                idx = items.index(target) + 1
                items.insert(idx, item)
            else:
                items.append(item)
        save_queue(project, items)
        return item

    item = with_lock(project, do_reorder)
    print(json.dumps(item))


def cmd_plan(args):
    project = args.project
    items = load_queue(project)

    pending = [i for i in items if i["status"] == "pending"]
    in_progress = [i for i in items if i["status"] == "in-progress"]
    completed_ids = {i["id"] for i in items if i["status"] == "completed"}

    # Compute dependency levels (topological)
    levels = {}
    for item in pending:
        deps = item.get("depends_on", [])
        unmet = [d for d in deps if d not in completed_ids]
        if not unmet:
            levels.setdefault(0, []).append(item)
        else:
            # Find max level of deps among pending items
            levels.setdefault(1, []).append(item)  # simplified: blocked = level 1

    # Tag clusters
    tag_groups = {}
    for item in pending + in_progress:
        for tag in item.get("tags", []):
            tag_groups.setdefault(tag, []).append(item["id"])

    # Active agents
    agents = {}
    for item in in_progress:
        if item["agent"]:
            agents.setdefault(item["agent"], []).append(item["id"])

    result = {
        "project": project,
        "pending": len(pending),
        "in_progress": len(in_progress),
        "completed": len([i for i in items if i["status"] == "completed"]),
        "failed": len([i for i in items if i["status"] == "failed"]),
        "held": len([i for i in items if i["status"] == "held"]),
        "ready": len(levels.get(0, [])),
        "blocked": len(levels.get(1, [])),
        "tag_clusters": {k: v for k, v in tag_groups.items()},
        "active_agents": agents,
    }
    print(json.dumps(result, indent=2))


# --- Argument parsing ---

def add_project_arg(parser):
    parser.add_argument("-p", "--project", default=None,
                        help="Project name (defaults to current dir name)")


def main():
    parser = argparse.ArgumentParser(description="Multi-agent work queue")
    sub = parser.add_subparsers(dest="command")

    # init
    p_init = sub.add_parser("init")
    add_project_arg(p_init)

    # add
    p_add = sub.add_parser("add")
    add_project_arg(p_add)
    p_add.add_argument("title")
    p_add.add_argument("description", nargs="?", default="")
    p_add.add_argument("--tags", default="")
    p_add.add_argument("--depends-on", dest="depends_on", default="")
    p_add.add_argument("--meta", nargs="*", default=None, help="key=value metadata pairs")

    # add-file
    p_af = sub.add_parser("add-file")
    add_project_arg(p_af)
    p_af.add_argument("file")

    # claim
    p_claim = sub.add_parser("claim")
    add_project_arg(p_claim)
    p_claim.add_argument("--agent", required=True)

    # yield
    p_yield = sub.add_parser("yield")
    add_project_arg(p_yield)
    p_yield.add_argument("id")
    p_yield.add_argument("--agent", required=True)

    # complete
    p_complete = sub.add_parser("complete")
    add_project_arg(p_complete)
    p_complete.add_argument("id")
    p_complete.add_argument("--branch", default=None)
    p_complete.add_argument("--clean", action="store_true")

    # fail
    p_fail = sub.add_parser("fail")
    add_project_arg(p_fail)
    p_fail.add_argument("id")
    p_fail.add_argument("--reason", default="")

    # release
    p_release = sub.add_parser("release")
    add_project_arg(p_release)
    p_release.add_argument("id")

    # set-meta
    p_setmeta = sub.add_parser("set-meta")
    add_project_arg(p_setmeta)
    p_setmeta.add_argument("id")
    p_setmeta.add_argument("key")
    p_setmeta.add_argument("value")

    # get-meta
    p_getmeta = sub.add_parser("get-meta")
    add_project_arg(p_getmeta)
    p_getmeta.add_argument("id")
    p_getmeta.add_argument("key", nargs="?", default=None)

    # status
    p_status = sub.add_parser("status")
    add_project_arg(p_status)

    # list
    p_list = sub.add_parser("list")
    add_project_arg(p_list)
    p_list.add_argument("--status", default=None)
    p_list.add_argument("--tag", default=None)
    p_list.add_argument("--json", dest="json_output", action="store_true")

    # clone
    p_clone = sub.add_parser("clone")
    p_clone.add_argument("url")
    p_clone.add_argument("session_id")
    p_clone.add_argument("--parent", default=None)

    # sync
    p_sync = sub.add_parser("sync")
    p_sync.add_argument("--dir", default=None)

    # plan
    p_plan = sub.add_parser("plan")
    add_project_arg(p_plan)

    # assign
    p_assign = sub.add_parser("assign")
    add_project_arg(p_assign)
    p_assign.add_argument("id")
    p_assign.add_argument("agent_id")

    # unassign
    p_unassign = sub.add_parser("unassign")
    add_project_arg(p_unassign)
    p_unassign.add_argument("id")

    # priority
    p_prio = sub.add_parser("priority")
    add_project_arg(p_prio)
    p_prio.add_argument("id")
    p_prio.add_argument("level", choices=["high", "normal", "low"])

    # hold
    p_hold = sub.add_parser("hold")
    add_project_arg(p_hold)
    p_hold.add_argument("id")

    # unhold
    p_unhold = sub.add_parser("unhold")
    add_project_arg(p_unhold)
    p_unhold.add_argument("id")

    # reorder
    p_reorder = sub.add_parser("reorder")
    add_project_arg(p_reorder)
    p_reorder.add_argument("id")
    p_reorder.add_argument("--before", default=None)
    p_reorder.add_argument("--after", default=None)

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(1)

    if not hasattr(args, "project") or not args.project:
        args.project = Path.cwd().name

    cmds = {
        "init": cmd_init, "add": cmd_add, "add-file": cmd_add_file,
        "claim": cmd_claim, "yield": cmd_yield_item, "complete": cmd_complete,
        "fail": cmd_fail, "release": cmd_release,
        "set-meta": cmd_set_meta, "get-meta": cmd_get_meta,
        "status": cmd_status, "list": cmd_list, "clone": cmd_clone,
        "sync": cmd_sync, "plan": cmd_plan, "assign": cmd_assign,
        "unassign": cmd_unassign, "priority": cmd_priority,
        "hold": cmd_hold, "unhold": cmd_unhold, "reorder": cmd_reorder,
    }
    cmds[args.command](args)


if __name__ == "__main__":
    main()
